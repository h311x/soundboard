{
	"name": "soundboard",
	"version": "0.1.10",
	"description": "Cross-platform desktop soundboard built with Electrobun",
	"scripts": {
		"start": "vite build && electrobun dev",
		"dev": "electrobun dev --watch",
		"dev:hmr": "concurrently \"bun run hmr\" \"bun run start\"",
		"hmr": "vite --port 5173",
		"build": "vite build",
		"build:stable": "vite build && electrobun build --env=stable && bun scripts/patch-win-metadata.ts",
		"build:canary": "vite build && electrobun build --env=canary",
		"icons": "bun scripts/generate-icons.ts"
	},
	"dependencies": {
		"@fontsource/ibm-plex-mono": "^5.2.5",
		"@fontsource/instrument-sans": "^5.2.5",
		"electrobun": "1.18.1",
		"react": "^18.3.1",
		"react-dom": "^18.3.1"
	},
	"devDependencies": {
		"@resvg/resvg-js": "^2.6.2",
		"@types/bun": "latest",
		"@types/react": "^18.3.12",
		"@types/react-dom": "^18.3.1",
		"@vitejs/plugin-react": "^4.3.4",
		"png-to-ico": "^2.1.8",
		"autoprefixer": "^10.4.20",
		"concurrently": "^9.1.0",
		"postcss": "^8.4.49",
		"tailwindcss": "^3.4.16",
		"typescript": "^5.7.2",
		"vite": "^6.0.3"
	}
}
