{
	"name": "soundboard",
	"version": "0.1.15",
	"description": "Cross-platform desktop soundboard built with Electrobun",
	"scripts": {
		"dev": "concurrently \"vite --port 5173\" \"vite build && electrobun dev\"",
		"build": "vite build && electrobun build --env=stable",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"typecheck": "tsc --noEmit",
		"fallow": "fallow",
		"fallow:fix": "fallow fix",
		"check": "bun run lint && bun run typecheck && bun run fallow",
		"test": "bun test"
	},
	"dependencies": {
		"@dnd-kit/core": "^6.3.1",
		"@dnd-kit/modifiers": "^9.0.0",
		"@dnd-kit/sortable": "^10.0.0",
		"@dnd-kit/utilities": "^3.2.2",
		"@fontsource/ibm-plex-mono": "^5.2.7",
		"@fontsource/instrument-sans": "^5.2.8",
		"electrobun": "^1.18.1",
		"react": "^19.2.6",
		"react-dom": "^19.2.6"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@tailwindcss/vite": "^4.3.0",
		"@types/bun": "latest",
		"@types/react": "^19.2.15",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^6.0.2",
		"concurrently": "^9.2.1",
		"eslint": "^10.4.0",
		"eslint-plugin-react-hooks": "^7.1.1",
		"eslint-plugin-react-refresh": "^0.5.2",
		"fallow": "^2.76.0",
		"globals": "^17.6.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"rcedit": "^4.0.1",
		"typescript-eslint": "^8.59.4",
		"vite": "^8.0.13"
	}
}
