{
	"name": "soundboard",
	"version": "0.1.10",
	"description": "Cross-platform desktop soundboard built with Electrobun",
	"scripts": {
		"start": "vite build && electrobun dev",
		"dev": "electrobun dev --watch",
		"dev:hmr": "concurrently \"bun run hmr\" \"bun run start\"",
		"hmr": "vite --port 5173",
		"build": "vite build",
		"build:stable": "vite build && electrobun build --env=stable && bun scripts/patch-win-metadata.ts",
		"build:canary": "vite build && electrobun build --env=canary",
		"icons": "bun scripts/generate-icons.ts",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"fallow": "fallow",
		"fallow:fix": "fallow fix"
	},
	"dependencies": {
		"@fontsource/ibm-plex-mono": "^5.2.7",
		"@fontsource/instrument-sans": "^5.2.8",
		"electrobun": "^1.18.1",
		"react": "^19.2.6",
		"react-dom": "^19.2.6"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@resvg/resvg-js": "^2.6.2",
		"@tailwindcss/vite": "^4.3.0",
		"@types/bun": "latest",
		"@types/react": "^19.2.15",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^6.0.2",
		"concurrently": "^9.2.1",
		"eslint": "^10.4.0",
		"eslint-plugin-react-hooks": "^7.1.1",
		"eslint-plugin-react-refresh": "^0.5.2",
		"fallow": "^2.76.0",
		"globals": "^17.6.0",
		"png-to-ico": "^3.0.1",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.59.4",
		"vite": "^8.0.13"
	}
}
