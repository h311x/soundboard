{
	"$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",

	"entry": [
		"src/bun/index.ts",
		"src/mainview/main.tsx",
		"electrobun.config.ts",
		"scripts/patch-win-metadata.ts"
	],

	"ignorePatterns": [
		"dist/**",
		"build/**",
		"artifacts/**",
		"assets/**"
	],

	"dynamicallyLoaded": ["src/bun/win-audio.ts"],

	"ignoreExports": [
		{ "file": "src/bun/win-audio.ts", "exports": ["*"] },
		{ "file": "electrobun.config.ts", "exports": ["default"] }
	],

	"ignoreDependencies": [
		"concurrently",
		"globals",
		"fallow",
		"@types/bun",
		"rcedit"
	],

	"ignoreExportsUsedInFile": true,
	"includeEntryExports": false,

	"rules": {
		"unused-files": "error",
		"unused-exports": "error",
		"unused-types": "error",
		"unused-dependencies": "error",
		"unlisted-dependencies": "error",
		"duplicate-exports": "error",
		"unresolved-imports": "error",
		"circular-dependencies": "error",
		"private-type-leaks": "error",
		"unused-enum-members": "error",
		"unused-class-members": "error",
		"stale-suppressions": "warn",
		"type-only-dependencies": "error",
		"test-only-dependencies": "error"
	},

	"duplicates": {
		"mode": "strict",
		"minLines": 5,
		"minTokens": 40,
		"threshold": 0.1
	},

	"health": {
		"maxCyclomatic": 12,
		"maxCognitive": 10,
		"maxCrap": 15,
		"ignore": ["scripts/**"],
		"suggestInlineSuppression": false
	}
}
